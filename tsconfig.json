{
    "compilerOptions": {
        "target": "es2017",
        "module": "es2015",
        "moduleResolution": "bundler",
        "lib": ["esnext.array", "esnext", "es2017", "dom"],
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "inlineSources": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "skipLibCheck": true,
        "allowSyntheticDefaultImports": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "outDir": "./",
        "rootDir": "./src"
    },
    "include": ["src/**/*.ts"],
    "exclude": []
}
